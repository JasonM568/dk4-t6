// 線上課程學習網站 — 資料模型（course schema 版）
// 金額一律用整數（新台幣元）。
// 會員身分在 Supabase auth.users（uuid），本 schema 不存任何密碼/帳號資料。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // …?schema=course（runtime，Supabase 走 6543 pooler）
  directUrl = env("DATABASE_URL_UNPOOLED") // …?schema=course（migrate 用，Supabase 必須 5432 direct）
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ── 會員統計（取代原 User 上的等級狀態欄位）──
// userId = Supabase auth.users.id（uuid）。lazy upsert：首次下單/付款時建立。
// 不建 FK：auth.users 在 auth schema，本機開發 PG 沒有該 schema。
model MemberStats {
  userId        String          @id @db.Uuid
  currentTierId String?
  currentTier   MembershipTier? @relation(fields: [currentTierId], references: [id])
  totalSpent    Int             @default(0) // 累積實付金額
  coursesBought Int             @default(0) // 累積購課數

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 管理員設定的會員初始密碼備查（僅後台顯示）。
// 注意：這不是 Auth 的真實密碼（Auth 只存雜湊不可逆）；學員自行改密碼後此表不會同步
model MemberPassword {
  userId    String   @id @db.Uuid
  password  String
  updatedBy String? // 設定的管理員 email
  updatedAt DateTime @updatedAt
}

// course 平台自管的後台幹部角色（admin 仍沿用 QBC public.profiles.role=admin，不存這裡）。
// OPERATOR=操作人員（可查看+編輯+匯出+批次/群發）；COACH=總教練（只能查看訂單/課程/會員）。
// userId = auth.users.id；email 為指派當下快照，純顯示用。
model StaffRole {
  userId    String   @id @db.Uuid
  role      String // OPERATOR | COACH
  email     String? // 指派當下 email 快照（權限管理頁顯示用）
  assignedBy String? // 指派的管理員 email
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 等級門檻設定表（後台可調）
model MembershipTier {
  id               String @id @default(cuid())
  name             String // 銅 / 銀 / 金
  level            Int    @unique // 0,1,2,3…（用於排序與比較）
  minTotalSpent    Int    @default(0) // 升級門檻：累積消費
  minCoursesBought Int    @default(0) // 升級門檻：購課數（與上者並用，須同時達標）
  discountPercent  Int    @default(0) // 折扣 %（0-100）

  members MemberStats[]
}

// 站台設定（key-value）：目前用於前台分頁開關（page:<key> = "on"/"off"，無資料列視為開啟）
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 群發通知/電子報：立即寄出的歷史紀錄＋排程待寄
// status：SCHEDULED（排程待寄）/ SENDING（cron 處理中）/ SENT / CANCELED / FAILED
// audienceType：ALL（全部會員）/ GROUP（名單群組）/ MANUAL（手動貼名單）
model EmailBroadcast {
  id            String    @id @default(cuid())
  subject       String
  body          String    @db.Text
  courseId      String? // 關聯課程（選填，信中帶課程連結）
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  sentBy        String? // 操作的管理員 email
  status        String    @default("SENT")
  scheduledAt   DateTime? // 預設發送時間（null = 立即寄出）
  sentAt        DateTime? // 實際寄出時間
  audienceType  String    @default("ALL") // ALL / GROUP / MANUAL / FOLLOWUP（跟進信）
  groupId       String? // audienceType=GROUP 時的群組（寄出當下取最新成員）
  audienceLabel String? // 顯示用：全部會員 / 群組：xxx / 手動名單 N 筆 / 跟進：開信者（來源：xxx）
  manualRows    Json? // audienceType=MANUAL 時的名單 [{email,name}]

  sourceBroadcastId String? // audienceType=FOLLOWUP 時的來源群發 id（軟連結不加 FK，與 resendOfId 慣例一致）
  followUpFilter    String? // 跟進條件：OPENED（開信者）/ NOT_OPENED（未開信者）/ CLICKED（點擊者）；名單於寄出當下解析
  recipients    String[]  @default([]) // 實際寄出名單快照（供事後存成群組）
  claimedAt     DateTime? // 進入 SENDING（cron 認領）的時間；用於回收逾時卡死的寄送

  failedRecipients Json? // 逐筆失敗名單 [{email,name?,reason}]；補寄後更新為「仍失敗子集」，全成功設 null
  resendOfId       String? // 此紀錄若為「補寄失敗者」，記來源群發紀錄 id（軟連結不加 FK，與 groupId 慣例一致）
  excludedCount    Int     @default(0) // 本次寄送因退訂被排除的人數（明細頁顯示用）

  createdAt DateTime @default(now())
}

// 電子報退訂名單：寄送前統一過濾（resolveRecipients），測試信不過濾
model MailUnsubscribe {
  email     String   @id // 存入前一律 toLowerCase().trim()
  reason    String?
  source    String   @default("USER") // USER（自行退訂）| BOUNCE（退信）| COMPLAINT（投訴）
  createdAt DateTime @default(now())
}

// 群發成效事件（Resend webhook 回流）；唯一鍵 = 同一群發同一人同一事件只記一次（唯一開信/點擊計數）
model BroadcastEvent {
  id          String   @id @default(cuid())
  broadcastId String // 軟連結（與 groupId/resendOfId 慣例一致，不加 FK）
  email       String
  type        String // DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED
  createdAt   DateTime @default(now())

  @@unique([broadcastId, email, type])
  @@index([broadcastId])
}

// EDM 範本：常用信件內容存檔，群發表單一鍵帶入後小幅修改再寄
// 只存內容（主旨/內文/關聯課程），發送對象每次寄送時自行選擇
model MailTemplate {
  id        String  @id @default(cuid())
  name      String  @unique // 範本名稱（同名儲存 = 覆蓋更新）
  subject   String
  body      String  @db.Text
  courseId  String? // 關聯課程（軟連結不加 FK，與 EmailBroadcast.courseId 慣例一致）
  createdBy String? // 最後儲存的管理員 email

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 電子報名單群組
model MailGroup {
  id      String            @id @default(cuid())
  name    String            @unique
  members MailGroupMember[]

  createdAt DateTime @default(now())
}

model MailGroupMember {
  id      String    @id @default(cuid())
  groupId String
  group   MailGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email   String
  name    String?

  createdAt DateTime @default(now())

  @@unique([groupId, email]) // 群組內 email 唯一，重複加入自動略過
  @@index([groupId])
}

// ── 企業專區（世華會等企業包班）──
// 課程掛 groupId 後即從公開型錄（/courses、首頁、checkout）隱藏，
// 僅專區會員（CourseGroupMember，以 email 比對）與後台幹部可見。
// 觀看權限仍走 Enrollment（逐課開通），專區只管「可見性」。
model CourseGroup {
  id           String  @id @default(cuid())
  slug         String  @unique // 前台路由 /zone/<slug>（如 shihua）
  name         String // 顯示名稱（如 世華會學習專區）
  wallText     String? @db.Text // 非會員擋牆頁的說明文字（選填，如聯絡窗口）
  isActive     Boolean @default(true) // 停用 = 前台整區 404
  themePrimary String? // 專區主題色 #RRGGBB（標題區/按鈕）；空 = 全站預設靛藍
  themeAccent  String? // 輔助色 #RRGGBB（漸層第二色/徽章）；空 = 沿用主題色

  courses     Course[]
  members     CourseGroupMember[]
  inviteCodes GroupInviteCode[]

  createdAt DateTime @default(now())
}

// 專區會員：以 email 為鍵（存入前一律 toLowerCase().trim()），
// 允許尚未註冊的 email 先入名單；userId 已知時回填，純稽核用。
model CourseGroupMember {
  id      String      @id @default(cuid())
  groupId String
  group   CourseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email   String
  name    String?
  userId  String?     @db.Uuid // auth.users.id，已知時回填
  source  String // MANUAL | IMPORT | INVITE
  addedBy String? // 操作管理員 email 或邀請碼 code

  createdAt DateTime @default(now())

  @@unique([groupId, email]) // 群組內 email 唯一，重複匯入自動略過
  @@index([groupId])
  @@index([email])
}

// 專區邀請碼：註冊頁帶 ?invite=CODE 或擋牆頁輸入即取得會籍。
// usedCount 純統計非上限；要停止發放就 isActive=false 或換碼。
model GroupInviteCode {
  id        String      @id @default(cuid())
  groupId   String
  group     CourseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code      String      @unique // 8 碼易讀隨機（去 0/O/1/I），比對時 uppercase
  label     String? // 備註（如 2026 年會發放）
  isActive  Boolean     @default(true)
  expiresAt DateTime? // null = 不限期
  usedCount Int         @default(0)
  createdBy String? // 產碼的管理員 email

  createdAt DateTime @default(now())
}

// 課程分類（後台自行維護選項，課程可勾選多個分類）
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  courses   Course[]

  createdAt DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  courseCode  String?  @unique // 課程編號（如 HA-001，選填）
  title       String
  description String   @db.Text
  coverImage  String?
  introImages String[] @default([]) // 課程介紹圖（詳情頁描述下方依序顯示）
  listPrice   Int? // 建議售價（僅展示用，前台劃線價；空 = 不顯示）
  price       Int // 優惠價 = 實際售價（新台幣整數，金流以此計算）
  sortOrder   Int      @default(0) // 前台顯示順序（小的在前，後台上移/下移調整）
  isPublished Boolean  @default(false)
  groupId     String? // 所屬企業專區；null = 一般公開販售課程
  group       CourseGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  openToGroupUntil DateTime? // 專區限時免開通觀看：此日期前專區會員不需 Enrollment 即可觀看；null/過期 = 回到手動開通

  lessons     Lesson[]
  materials   CourseMaterial[]
  categories  Category[]
  orderItems  OrderItem[]
  enrollments Enrollment[]
  pendingEnrollments PendingEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
}

// ── 講座報名頁 ──
// 訪客到 /webinar/[slug] 輸入 email → 寄含講座連結的品牌信，
// 並自動加入指定 EDM 名單群組（groupId 軟連結，慣例同 EmailBroadcast）。
model Webinar {
  id           String  @id @default(cuid())
  slug         String  @unique // 公開網址 /webinar/[slug]
  title        String
  description  String  @db.Text // 頁面說明（純文字換行顯示）
  lectureUrl   String // 講座連結（寄信用，不直接露出在頁面）
  dmImage      String? // 講座 DM 圖（瀏覽器直傳 Storage 的公開網址，頁面說明上方顯示）
  emailSubject String
  emailBody    String  @db.Text // 支援 {link}=講座連結、[按鈕文字](網址) CTA
  groupId      String? // 索取者自動加入的 MailGroup；null = 不加名單
  isActive     Boolean @default(true) // 關閉後頁面顯示「已結束」不再寄信

  requests WebinarRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 索取紀錄：同講座同 email 一筆，重複索取更新寄送次數（60 秒限流防轟炸）
model WebinarRequest {
  id         String    @id @default(cuid())
  webinarId  String
  webinar    Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  email      String // 一律小寫正規化
  sentCount  Int       @default(0)
  lastSentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([webinarId, email])
  @@index([webinarId])
}

// ── 課程場次看板 ──
// 實體/直播開課「場次」，獨立於 Course（平台觀看權限）體系。
// 後台手動上架場次＋定期上傳 1shop 訂單檔 → 依產品關鍵字歸入場次；
// /board 憑 4 位碼（SiteSetting boardCode）唯讀查看報名人數與姓名。
model CourseSession {
  id        String    @id @default(cuid())
  title     String // 場次名稱（例：8/20 AI初階 台北場）
  eventDate DateTime? // 開課日期（看板排序/顯示用，可空）
  keywords  String[]  @default([]) // 訂單「產品」欄含任一關鍵字 → 歸入本場次
  isVisible Boolean   @default(true) // 顯示於 /board 看板
  sortOrder Int       @default(0)

  signups SessionSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 場次報名（來源：1shop 訂單匯入）。只收金流狀態=已付款的列。
model SessionSignup {
  id        String        @id @default(cuid())
  sessionId String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderNo   String // 1shop 訂單編號
  name      String // 顧客姓名（看板顯示）
  email     String?
  phone     String?
  product   String? // 原始產品欄（追溯歸類依據）
  amount    Int? // 該列小計（新台幣整數）
  orderedAt DateTime? // 訂單建立日期

  createdAt DateTime @default(now())

  @@unique([sessionId, orderNo]) // 重複上傳冪等（同單同場次只算一筆）
  @@index([sessionId])
}

// 待開通名單：批次開通遇「查無會員」時存底（以 email 為鍵），
// 學員之後註冊（或管理員建帳號）當下自動認領 → 寫入 Enrollment。
// claimedAt 有值 = 已認領（留存稽核，不重複觸發）；待註冊人數 = claimedAt IS NULL。
model PendingEnrollment {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  email    String // 一律小寫正規化（normalizeEmail）
  name     String? // 名單附的姓名（認領建帳號時備查）

  createdBy String? // 存底的管理員 email（備查）
  createdAt DateTime  @default(now())
  claimedAt DateTime? // 認領時間（註冊/建帳號當下）
  userId    String?   @db.Uuid // 認領人 auth.users.id（無 FK，慣例同 Enrollment）

  @@unique([courseId, email]) // 同課程同 email 只存一筆，重貼名單冪等
  @@index([email])
}

model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  youtubeId   String // 只存 YouTube video id，播放頁才組成 embed
  slideUrl    String? // 線上簡報嵌入網址（Google Slides/Canva），播放頁影片下方顯示
  order       Int
  durationSec Int?

  @@index([courseId])
}

// 課程講義（下載檔案，存 Supabase Storage 或外部網址）
model CourseMaterial {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  url      String

  createdAt DateTime @default(now())

  @@index([courseId])
}

model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique // ECPay MerchantTradeNo（≤20 字元）
  userId      String      @db.Uuid // auth.users.id，無 FK
  buyerEmail  String? // 下單當下 email 快照（後台顯示與稽核用）
  status      OrderStatus @default(PENDING)
  subtotal    Int // 折扣前總額
  discount    Int         @default(0) // 套用的折扣金額
  total       Int // 實付 = subtotal - discount
  tierAtOrder Int? // 下單當下等級 level（稽核用）

  items   OrderItem[]
  payment Payment?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course @relation(fields: [courseId], references: [id])
  unitPrice Int // 下單當下價格快照

  @@unique([orderId, courseId])
  @@index([courseId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String // "ecpay" | "newebpay"
  status      PaymentStatus @default(PENDING)
  amount      Int
  tradeNo     String? // 金流商交易序號（回傳）
  paymentType String? // Credit / ATM / CVS…
  rawCallback Json? // 完整 callback 存證
  notifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 已購買關係 — 「能不能看課程」的唯一真實來源
model Enrollment {
  id       String  @id @default(cuid())
  userId   String  @db.Uuid // auth.users.id，無 FK
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])
  orderId  String? // 來源訂單
  source   String? // 開通來源：PURCHASE/MANUAL/BATCH/IMPORT（null=歷史資料，顯示時依 orderId 推斷）

  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // 防重複授權，並保證 webhook 冪等
  @@index([userId])
}
