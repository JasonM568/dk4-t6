// 線上課程學習網站 — 資料模型（course schema 版）
// 金額一律用整數（新台幣元）。
// 會員身分在 Supabase auth.users（uuid），本 schema 不存任何密碼/帳號資料。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // …?schema=course（runtime，Supabase 走 6543 pooler）
  directUrl = env("DATABASE_URL_UNPOOLED") // …?schema=course（migrate 用，Supabase 必須 5432 direct）
}

// 訂單狀態＝金流態（機器寫）＋營運態（人寫）共用一個生命週期：
//   PENDING 待付款 → AWAITING_CONFIRM 待確認（人工收款場景）→ PAID 已付款
//   → CONFIRMED 已確認 → COMPLETED 已完成；CANCELLED 已取消（人工）
//   FAILED / EXPIRED / REFUNDED 為金流事件態
// 鐵則：PAID 只能由金流結算寫入（webhook 或「金流確認補開通」），
// 後台手動編輯不得直接設 PAID；已結算判斷見 settle.ts 的 SETTLED_STATUSES
enum OrderStatus {
  PENDING
  AWAITING_CONFIRM
  PAID
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ── 會員統計（取代原 User 上的等級狀態欄位）──
// userId = Supabase auth.users.id（uuid）。lazy upsert：首次下單/付款時建立。
// 不建 FK：auth.users 在 auth schema，本機開發 PG 沒有該 schema。
model MemberStats {
  userId        String          @id @db.Uuid
  currentTierId String?
  currentTier   MembershipTier? @relation(fields: [currentTierId], references: [id])
  totalSpent    Int             @default(0) // 累積實付金額
  coursesBought Int             @default(0) // 累積購課數

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 管理員設定的會員初始密碼備查（僅後台顯示）。
// 注意：這不是 Auth 的真實密碼（Auth 只存雜湊不可逆）；學員自行改密碼後此表不會同步
model MemberPassword {
  userId    String   @id @db.Uuid
  password  String
  updatedBy String? // 設定的管理員 email
  updatedAt DateTime @updatedAt
}

// 本平台自管的會員補充資料（QBC public.profiles 唯讀不可動，手機與個資同意存這裡）。
// phone = normalizeMobile 產物（09XXXXXXXX）；個資法履行紀錄要能舉證「何時同意了哪一版條款」
model MemberProfile {
  userId                String    @id @db.Uuid // auth.users.id，無 FK
  name                  String? // 訂購人姓名（結帳前必填；QBC profiles 唯讀，姓名自管）
  phone                 String
  // 同意欄位 nullable：1shop 訂單回填只寫 phone（同意必須由會員本人操作，不可代填）。
  // 「補填完成」的定義＝有手機且有同意（見 src/lib/member-profile.ts）
  privacyConsentAt      DateTime? // 勾選同意的時間戳
  privacyConsentVersion String? // 同意當下的條款版本（見 src/lib/privacy.ts）
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([phone])
}

// 歷史學員主檔：尚未註冊者也可先匯入。
// 識別鍵是「手機」不是 email——夫妻、親子共用一個信箱在實務上很常見
// （蘇郁雅報名時填的是先生陳建中的信箱），email 當唯一鍵會讓第二個人根本建不了檔。
// email 保留為選填、不設唯一，只在「該信箱剛好只有一筆」時當認領備援。
model StudentRecord {
  id                 String                 @id @default(cuid())
  phone              String?                @unique
  email              String?
  name               String?
  legacyAccessStatus String                 @default("UNKNOWN") // NONE / ACTIVE / TO_MIGRATE / MIGRATED / UNKNOWN
  legacyNote         String?                @db.Text
  archivedAt         DateTime?
  archivedBy         String?
  archiveReason      String?                @db.Text
  claimedUserId      String?                @db.Uuid
  claimedAt          DateTime?
  histories          StudentCourseHistory[]
  engagements        StudentEngagement[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([email])
  @@index([claimedUserId])
  @@index([archivedAt])
}

model StudentCourseHistory {
  id         String        @id @default(cuid())
  studentId  String
  student    StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseName String
  attendedAt DateTime?
  source     String? // IMPORT / MANUAL / 1SHOP
  note       String?       @db.Text
  createdAt  DateTime      @default(now())

  @@index([studentId])
}

// 非正式課程的接觸紀錄：讀冊會、頻率意識地圖、講座與其他活動。
// 這些紀錄用於潛在名單分眾，不得計入「上過幾堂課」。
model StudentEngagement {
  id         String        @id @default(cuid())
  studentId  String
  student    StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String // BOOK_CLUB / FREQUENCY_MAP / SEMINAR / EVENT / OTHER
  title      String
  occurredAt DateTime?
  source     String?
  sourceRef  String?
  note       String?       @db.Text
  createdAt  DateTime      @default(now())

  @@index([studentId])
  @@index([type])
}

// 學員主檔維護稽核。student/history 被刪後仍須保留，因此刻意不設 FK。
model StudentDataAuditLog {
  id         String   @id @default(cuid())
  studentId  String?
  historyId  String?
  action     String
  actorEmail String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([createdAt])
}

// 一次人工合併的完整、可還原操作單。刻意不設 StudentRecord FK，來源卡刪除後仍須存在。
model StudentMergeOperation {
  id              String    @id @default(cuid())
  sourceStudentId String
  targetStudentId String
  actorEmail      String?
  snapshotJson    Json
  status          String    @default("ACTIVE") // ACTIVE / RESTORED
  restoredAt      DateTime?
  restoredBy      String?
  createdAt       DateTime  @default(now())

  @@index([targetStudentId, status, createdAt])
  @@index([sourceStudentId, createdAt])
}

// 標準課程主檔（課名歸戶的目的地）：歷史紀錄的課名同一門課有六七種寫法
// （「3/26 AI 變現入門課」「2026.03.26 AI初階課程」…），歸戶後記錄卡才像履歷、
// 分眾名單（上過 X 未上過 Y）才算得出來。kind/level 值域見 src/lib/student-course.ts
model CanonicalCourse {
  id        String               @id // 可讀 slug（qm-basic、ai-basic…），種子與分眾查詢直接引用
  name      String               @unique
  kind      String               @default("COURSE") // COURSE / SUBSCRIPTION / SEMINAR / EVENT / PRODUCT / OTHER
  level     String? // BASIC / ADVANCED；非課程為 null
  sortOrder Int                  @default(0)
  aliases   StudentCourseAlias[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

// 課名原文 → 標準課程。完整原文比對、不做模糊比對（同 FinancePlanAlias 的理由：避免誤套）；
// 新場次產生的新課名會落在「未歸戶」清單，由後台指派一次即長期受用。
model StudentCourseAlias {
  rawName   String          @id
  courseId  String
  course    CanonicalCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  updatedBy String?
  updatedAt DateTime        @updatedAt

  @@index([courseId])
}

// 看板登入共享限流（跨 serverless instance）：key = "ip:<addr>" 或 "global"
model BoardLoginThrottle {
  key         String    @id
  failCount   Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// CSP 違規回報（Report-Only 觀察期用）：同一組 directive+來源+頁面只留一列累加次數，
// 資料量才不會被瀏覽器灌爆。確認完整白名單無誤殺後即可切正式阻擋，屆時此表可留可刪。
model CspReport {
  id           String   @id @default(cuid())
  directive    String
  blockedUri   String
  documentPath String
  count        Int      @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([directive, blockedUri, documentPath])
}

// 敏感後台操作稽核（密碼重設等）：只記操作者/目標/結果，絕不記密碼內容
model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String // PASSWORD_RESET / PASSWORD_RESET_BULK
  actorId    String   @db.Uuid
  actorEmail String?
  targetId   String   @db.Uuid
  success    Boolean
  detail     String? // 失敗原因或拒絕理由（不含密碼）
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetId])
}

// 課程平台會員列表封存：只影響本平台後台呈現，不刪除／停用共用 Supabase Auth。
// 訂單、Enrollment、學員履歷與舊官網登入皆維持原狀，可隨時解除封存。
model MemberArchive {
  userId     String   @id @db.Uuid
  reason     String?  @db.Text
  archivedBy String?
  archivedAt DateTime @default(now())

  @@index([archivedAt])
}

// course 平台自管的後台幹部角色（admin 仍沿用 QBC public.profiles.role=admin，不存這裡）。
// OPERATOR=操作人員（可查看+編輯+匯出+批次/群發）；COACH=總教練（只能查看訂單/課程/會員）。
// userId = auth.users.id；email 為指派當下快照，純顯示用。
model StaffRole {
  userId     String   @id @db.Uuid
  role       String // OPERATOR | COACH
  email      String? // 指派當下 email 快照（權限管理頁顯示用）
  assignedBy String? // 指派的管理員 email
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 等級門檻設定表（後台可調）
model MembershipTier {
  id               String @id @default(cuid())
  name             String // 銅 / 銀 / 金
  level            Int    @unique // 0,1,2,3…（用於排序與比較）
  minTotalSpent    Int    @default(0) // 升級門檻：累積消費
  minCoursesBought Int    @default(0) // 升級門檻：購課數（與上者並用，須同時達標）
  discountPercent  Int    @default(0) // 折扣 %（0-100）

  members MemberStats[]
}

// 站台設定（key-value）：目前用於前台分頁開關（page:<key> = "on"/"off"，無資料列視為開啟）
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 群發通知/電子報：立即寄出的歷史紀錄＋排程待寄
// status：SCHEDULED（排程待寄）/ SENDING（cron 處理中）/ SENT / CANCELED / FAILED
// audienceType：ALL（全部會員）/ GROUP（名單群組，可複選）/ SESSION（場次報名者，可複選）/ MANUAL（手動貼名單）
// messageType（比照 SmsBroadcast）：
//   MARKETING 行銷推播／電子報（預設）——退訂名單全擋，既有紀錄行為完全不變
//   NOTICE    履約通知（已報名學員的課前通知／異動通知）——只擋 BOUNCE（退信）與
//             COMPLAINT（檢舉垃圾信），不因「退訂電子報」而擋掉他付費課程的上課通知
//   僅「場次報名者／手動名單／選取會員」可標 NOTICE；全部會員與名單群組是電子報血統，
//   一律 MARKETING（見 actions/admin.ts NOTICE_ALLOWED_AUDIENCES）
model EmailBroadcast {
  id            String    @id @default(cuid())
  subject       String
  body          String    @db.Text
  messageType   String    @default("MARKETING")
  noticeAckBy   String? // 勾選「這是履約通知，非行銷推播」的管理員 email（稽核用）
  courseId      String? // 關聯課程（選填，信中帶課程連結）
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  sentBy        String? // 操作的管理員 email
  status        String    @default("SENT")
  scheduledAt   DateTime? // 預設發送時間（null = 立即寄出）
  sentAt        DateTime? // 實際寄出時間
  audienceType  String    @default("ALL") // ALL / GROUP / MANUAL / FOLLOWUP（跟進信）
  groupId       String? // 舊欄位（單選時代）；新寫入一律 = groupIds[0]，讀取請用 broadcastGroupIds()
  groupIds      String[]  @default([]) // audienceType=GROUP 的名單群組，可複選；寄出當下取聯集並以 email 去重
  // audienceType=SESSION 的場次（可複選）：與 SmsBroadcast.sessionIds 同義，
  // 一次匯入的場次名單同時餵 EDM 與簡訊兩個模組；寄出當下才取名單（新報名者自動涵蓋）
  sessionIds    String[]  @default([])
  audienceLabel String? // 顯示用：全部會員 / 群組：xxx / 場次：xxx / 手動名單 N 筆 / 跟進：開信者（來源：xxx）
  manualRows    Json? // audienceType=MANUAL 時的名單 [{email,name}]

  sourceBroadcastId String? // audienceType=FOLLOWUP 時的來源群發 id（軟連結不加 FK，與 resendOfId 慣例一致）
  followUpFilter    String? // 跟進條件：OPENED（開信者）/ NOT_OPENED（未開信者）/ CLICKED（點擊者）；名單於寄出當下解析
  recipients        String[]  @default([]) // 實際寄出名單快照（供事後存成群組）
  claimedAt         DateTime? // 進入 SENDING（cron 認領）的時間；用於回收逾時卡死的寄送

  failedRecipients Json? // 逐筆失敗名單 [{email,name?,reason}]；補寄後更新為「仍失敗子集」，全成功設 null
  resendOfId       String? // 此紀錄若為「補寄失敗者」，記來源群發紀錄 id（軟連結不加 FK，與 groupId 慣例一致）
  excludedCount    Int     @default(0) // 本次寄送因退訂被排除的人數（明細頁顯示用）

  createdAt DateTime @default(now())
}

// EDM 逐收件人 provider 接受結果。
// broadcastId 刻意維持軟連結、不設 FK：EmailBroadcast 與其他歷史指向欄位都採同一慣例，
// 避免日後清理單一資料時 cascade 破壞寄送稽核紀錄。
// status：PENDING（已解析、尚未取得結果）/ ACCEPTED（Resend 回傳 message id）/ FAILED。
// DELIVERED / OPENED / CLICKED / BOUNCED / COMPLAINED 仍由 BroadcastEvent 表示。
model EmailBroadcastRecipient {
  id                String   @id @default(cuid())
  broadcastId       String
  email             String
  name              String?
  status            String   @default("PENDING")
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([broadcastId, email])
  @@index([broadcastId, status])
}

// 電子報退訂名單：寄送前統一過濾（resolveRecipients），測試信不過濾
model MailUnsubscribe {
  email     String   @id // 存入前一律 toLowerCase().trim()
  reason    String?
  source    String   @default("USER") // USER（自行退訂）| BOUNCE（退信）| COMPLAINT（投訴）
  createdAt DateTime @default(now())
}

// 群發成效事件（Resend webhook 回流）；唯一鍵 = 同一群發同一人同一事件只記一次（唯一開信/點擊計數）
model BroadcastEvent {
  id          String   @id @default(cuid())
  broadcastId String // 軟連結（與 groupId/resendOfId 慣例一致，不加 FK）
  email       String
  type        String // DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED
  createdAt   DateTime @default(now())

  @@unique([broadcastId, email, type])
  @@index([broadcastId])
}

// EDM 逐連結點擊彙總：同一封信／收件人／URL 一列，保留首次、最後與次數。
// 不保存 Resend click payload 的 IP / user agent（分析不需要，遵守資料最小化）。
model BroadcastLinkEvent {
  id             String   @id @default(cuid())
  broadcastId    String
  email          String
  url            String   @db.Text
  urlHash        String
  firstClickedAt DateTime
  lastClickedAt  DateTime
  clickCount     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([broadcastId, email, urlHash])
  @@index([broadcastId, lastClickedAt])
}

// Webhook 技術收據：防止 Svix 以同一 svix-id 重送時重複累加 clickCount。
// 只存識別碼與事件型別，不保存原始 payload。
model WebhookReceipt {
  id        String   @id @default(cuid())
  svixId    String   @unique
  eventType String
  createdAt DateTime @default(now())
}

// EDM 範本：常用信件內容存檔，群發表單一鍵帶入後小幅修改再寄
// 只存內容（主旨/內文/關聯課程），發送對象每次寄送時自行選擇
model MailTemplate {
  id        String  @id @default(cuid())
  name      String  @unique // 範本名稱（同名儲存 = 覆蓋更新）
  subject   String
  body      String  @db.Text
  courseId  String? // 關聯課程（軟連結不加 FK，與 EmailBroadcast.courseId 慣例一致）
  createdBy String? // 最後儲存的管理員 email

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 電子報名單群組
model MailGroup {
  id      String            @id @default(cuid())
  name    String            @unique
  members MailGroupMember[]

  createdAt DateTime @default(now())
}

model MailGroupMember {
  id      String    @id @default(cuid())
  groupId String
  group   MailGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email   String
  name    String?

  createdAt DateTime @default(now())

  @@unique([groupId, email]) // 群組內 email 唯一，重複加入自動略過
  @@index([groupId])
}

// ── 企業專區（世華會等企業包班）──
// 課程掛 groupId 後即從公開型錄（/courses、首頁、checkout）隱藏，
// 僅專區會員（CourseGroupMember，以 email 比對）與後台幹部可見。
// 觀看權限仍走 Enrollment（逐課開通），專區只管「可見性」。
model CourseGroup {
  id           String  @id @default(cuid())
  slug         String  @unique // 前台路由 /zone/<slug>（如 shihua）
  name         String // 顯示名稱（如 世華會學習專區）
  wallText     String? @db.Text // 非會員擋牆頁的說明文字（選填，如聯絡窗口）
  isActive     Boolean @default(true) // 停用 = 前台整區 404
  kind         String  @default("BUSINESS") // BUSINESS=企業包班；SUBSCRIPTION=訂閱會員影片專區
  themePrimary String? // 專區主題色 #RRGGBB（標題區/按鈕）；空 = 全站預設靛藍
  themeAccent  String? // 輔助色 #RRGGBB（漸層第二色/徽章）；空 = 沿用主題色

  courses           Course[]
  members           CourseGroupMember[]
  inviteCodes       GroupInviteCode[]
  dailyBriefs       DailyBrief[]
  subscriptionPlans SubscriptionPlan[]
  subscriptions     Subscription[]

  createdAt DateTime @default(now())
}

// 訂閱金流與會籍狀態：付款供應商 adapter 完成後，回呼只需寫入此處並同步 group member。
model SubscriptionPlan {
  id            String         @id @default(cuid())
  groupId       String
  group         CourseGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  interval      String // MONTHLY | YEARLY
  price         Int
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                String                @id @default(cuid())
  groupId           String
  group             CourseGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  planId            String
  plan              SubscriptionPlan      @relation(fields: [planId], references: [id])
  email             String
  userId            String?               @db.Uuid
  status            String                @default("PENDING") // PENDING | ACTIVE | FAILED | CANCELED | EXPIRED
  provider          String?
  providerRef       String?               @unique
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  payments          SubscriptionPayment[]

  @@index([email, status])
  @@index([groupId, status])
}

model SubscriptionPayment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Int
  status          String       @default("PENDING")
  providerTradeNo String?
  paidAt          DateTime?
  rawPayload      Json?
  createdAt       DateTime     @default(now())

  @@index([subscriptionId, status])
}

// ── 訂閱專區每日財經剪報 ──
// 管理員只需上傳新聞截圖；標題、日期與三款固定封面由系統產生。
model DailyBrief {
  id           String            @id @default(cuid())
  groupId      String
  group        CourseGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dateKey      String // Asia/Taipei 日期，YYYY-MM-DD；每個專區每天一篇
  title        String
  coverVariant Int               @default(0) // 0/1/2 三款系統固定封面輪替
  status       String            @default("PUBLISHED") // DRAFT | PUBLISHED | UNPUBLISHED
  publishedAt  DateTime?
  images       DailyBriefImage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([groupId, dateKey])
  @@index([groupId, status, dateKey])
}

model DailyBriefImage {
  id        String     @id @default(cuid())
  briefId   String
  brief     DailyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([briefId, sortOrder])
}

// 專區會員：以 email 為鍵（存入前一律 toLowerCase().trim()），
// 允許尚未註冊的 email 先入名單；userId 已知時回填，純稽核用。
model CourseGroupMember {
  id      String      @id @default(cuid())
  groupId String
  group   CourseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email   String
  name    String?
  userId  String?     @db.Uuid // auth.users.id，已知時回填
  source  String // MANUAL | IMPORT | INVITE
  addedBy String? // 操作管理員 email 或邀請碼 code

  createdAt DateTime @default(now())

  @@unique([groupId, email]) // 群組內 email 唯一，重複匯入自動略過
  @@index([groupId])
  @@index([email])
}

// 專區邀請碼：註冊頁帶 ?invite=CODE 或擋牆頁輸入即取得會籍。
// usedCount 純統計非上限；要停止發放就 isActive=false 或換碼。
model GroupInviteCode {
  id        String      @id @default(cuid())
  groupId   String
  group     CourseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code      String      @unique // 8 碼易讀隨機（去 0/O/1/I），比對時 uppercase
  label     String? // 備註（如 2026 年會發放）
  isActive  Boolean     @default(true)
  expiresAt DateTime? // null = 不限期
  usedCount Int         @default(0)
  createdBy String? // 產碼的管理員 email

  createdAt DateTime @default(now())
}

// 課程分類（後台自行維護選項，課程可勾選多個分類）
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  courses   Course[]

  createdAt DateTime @default(now())
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  courseCode       String?      @unique // 課程編號（如 HA-001，選填）
  title            String
  description      String       @db.Text
  coverImage       String?
  introImages      String[]     @default([]) // 課程介紹圖（詳情頁描述下方依序顯示）
  listPrice        Int? // 建議售價（僅展示用，前台劃線價；空 = 不顯示）
  price            Int // 優惠價 = 實際售價（新台幣整數，金流以此計算）
  sortOrder        Int          @default(0) // 前台顯示順序（小的在前，後台上移/下移調整）
  isPublished      Boolean      @default(false)
  unpublishAt      DateTime? // 公開課程自動下架時間；到點後型錄、詳情與結帳一律關閉
  groupId          String? // 所屬企業專區；null = 一般公開販售課程
  group            CourseGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  openToGroupUntil DateTime? // 專區限時免開通觀看：此日期前專區會員不需 Enrollment 即可觀看；null/過期 = 回到手動開通

  lessons            Lesson[]
  materials          CourseMaterial[]
  categories         Category[]
  orderItems         OrderItem[]
  enrollments        Enrollment[]
  pendingEnrollments PendingEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
}

// ── 自訂分頁 ──
// 後台「分頁管理」自建的前台頁面（/p/[slug]）：標題＋內文（換行分段、
// 網址自動連結、[按鈕文字](網址) CTA）＋圖片（直傳 Storage）。
// showInNav 控制是否出現在導覽列；isPublished 關閉即 404。
model CustomPage {
  id          String   @id @default(cuid())
  slug        String   @unique // 前台網址 /p/[slug]
  title       String
  content     String   @db.Text
  images      String[] @default([]) // 內文下方依序顯示
  // 短影片行銷頁：YouTube 連結（嵌入播放）或影片檔直連網址，顯示在標題下方；
  // 有影片的頁面會發 Pixel ViewContent，供 FB 廣告圈「看過影片的人」受眾
  videoUrl    String?
  isPublished Boolean  @default(true)
  showInNav   Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 知識專欄 ──
// 從「系統設定 → 分頁管理」維護；可公開或僅限任一訂閱專區會員閱讀。
model KnowledgeArticle {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String    @db.Text
  coverImage  String?
  content     String    @db.Text
  images      String[]  @default([])
  tags        String[]  @default([])
  visibility  String    @default("PUBLIC") // PUBLIC | SUBSCRIBER
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | UNPUBLISHED
  publishedAt DateTime?
  unpublishAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([visibility, status])
}

// ── 講座報名頁 ──
// 訪客到 /webinar/[slug] 輸入 email → 寄含講座連結的品牌信，
// 並自動加入指定 EDM 名單群組（groupId 軟連結，慣例同 EmailBroadcast）。
model Webinar {
  id              String    @id @default(cuid())
  slug            String    @unique // 公開網址 /webinar/[slug]
  title           String
  description     String    @db.Text // 頁面說明（純文字換行顯示）
  lectureUrl      String // 講座連結（寄信用，不直接露出在頁面）
  meetingId       String? // 會議 ID（Zoom 等；只進信件不露出在頁面）
  meetingPassword String? // 會議密碼；連結無 pwd 參數時自動附加 ?pwd=
  meetingInfo     String?   @db.Text // 會議補充資訊（時間/注意事項，附在信末資訊區塊）
  dmImage         String? // 講座 DM 圖（瀏覽器直傳 Storage 的公開網址，頁面說明上方顯示）
  emailSubject    String
  emailBody       String    @db.Text // 支援 {link}=講座連結、[按鈕文字](網址) CTA
  groupId         String? // 索取者自動加入的 MailGroup；null = 不加名單
  isActive        Boolean   @default(true) // 關閉後頁面顯示「已結束」不再寄信
  endDate         DateTime? // 講座結束日：當天照常，隔天（台北時間）看板自動下架＋報名頁自動關閉；null = 不自動結束
  unpublishAt     DateTime? // 精確自動下架時間；與舊結束日並存，任一到期即關閉

  requests WebinarRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 索取紀錄：同講座同 email 一筆，重複索取更新寄送次數（60 秒限流防轟炸）
model WebinarRequest {
  id             String    @id @default(cuid())
  webinarId      String
  webinar        Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  email          String // 一律小寫正規化
  name           String? // 訪客填的姓名（重複索取以最新為準）
  // 手機（09XXXXXXXX，normalizeMobile 正規化後存）：開課前提醒簡訊與學員記錄卡歸戶用。
  // 2026-09-02 起表單必填，但欄位可空——上線前的舊索取紀錄沒有手機、補不回來。
  phone          String?
  sentCount      Int       @default(0)
  lastSentAt     DateTime?
  // 講座信寄送狀態（Resend webhook 回流，依嚴重度只升不降）：
  // SENT | DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED | FAILED；null = 追蹤上線前的舊資料
  deliveryStatus String?
  deliveryDetail String? // 退信/寄送失敗原因（訊息前 500 字）
  deliveryAt     DateTime? // 最後一次狀態更新時間

  createdAt DateTime @default(now())

  @@unique([webinarId, email])
  @@index([webinarId])
}

// ── 企業包班諮詢 ──
// /corporate 公開表單：企業留下基本資料與包班需求；
// 後台 /admin/corporate 名單管理，新單 Email 通知（收件人存 SiteSetting corporateNotifyEmail）。
model CorporateInquiry {
  id            String   @id @default(cuid())
  companyName   String // 公司/單位名稱
  contactName   String // 聯絡人姓名
  contactTitle  String? // 職稱
  email         String // 一律小寫正規化
  phone         String // 聯絡電話
  headcount     String? // 預計參訓人數（區間文字）
  topics        String[] @default([]) // 感興趣的課程主題（複選）
  trainingType  String? // 上課形式：實體/線上/皆可
  preferredTime String? // 期望開課時段（自由文字）
  budget        String? // 預算範圍（區間文字）
  message       String?  @db.Text // 需求說明
  status        String   @default("NEW") // NEW 新進 / CONTACTED 洽談中 / WON 已成交 / CLOSED 已結案
  adminNote     String?  @db.Text // 內部追蹤備註

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ── 課程場次看板 ──
// 實體/直播開課「場次」，獨立於 Course（平台觀看權限）體系。
// 後台手動上架場次＋定期上傳 1shop 訂單檔 → 依產品關鍵字歸入場次；
// /board 憑 4 位碼（SiteSetting boardCode）唯讀查看報名人數與姓名。
model CourseSession {
  id        String    @id @default(cuid())
  title     String // 場次名稱（例：8/20 AI初階 台北場）
  eventDate DateTime? // 開課日期（看板排序/顯示用，可空；過了隔天看板自動下架）
  endDate   DateTime? // 結束日（多日課程用）：有值時以此為準取代 eventDate 判斷下架；null = 以 eventDate 為準
  keywords  String[]  @default([]) // 訂單「產品」欄含任一關鍵字 → 歸入本場次
  isVisible Boolean   @default(true) // 顯示於 /board 看板
  adminNote String?   @db.Text // 僅後台管理用的場次備忘，不顯示於公開看板
  sortOrder Int       @default(0)
  groupCap  Int       @default(8) // 每組人數上限預設值（自動分組用；組數 = max(6, ⌈人數/上限⌉)）
  groupCaps Int[]     @default([]) // 逐組上限覆寫（index 0 = 第 1 組；0 或缺值 = 用 groupCap）——場地桌子大小不一時逐組調

  // ── 上課連結（/live 憑碼索取）──
  // 發簡訊給學員後，他們到 /live 輸入這場的 4 位上課碼即可看到會議連結與課程資料。
  // 碼綁在「場次」而非全站：一組碼外流只露出那一場，且不同場次的人看不到彼此的連結。
  accessCode      String? @unique // 4 位數字；null = 這場沒開放索取
  meetingUrl      String? // Zoom 等會議連結
  meetingId       String? // 會議 ID（給手動輸入用）
  meetingPassword String? // 會議密碼；連結沒帶 pwd 參數時自動附加（同 Webinar 慣例）
  meetingInfo     String? @db.Text // 課程資料／上課須知（講義連結、注意事項），純文字換行

  // 收支表模板：QUANTUM 量子思維 / GENERAL 一般課程 / SEMINAR 講座。
  // null = 依場次名稱自動判斷（deriveFinanceTemplate）；收支頁可人工指定
  financeTemplate String?

  // ── 公開報名頁（/event/<signupSlug>）Phase 1 ──
  // 自建報名頁只換「資料來源」：訪客送出後一樣寫進 SessionSignup（orderNo 前綴 WEB-），
  // 看板／分組／簽到表／課前通知／收支表全部沿用既有流程，不另立一套報名訂單模型。
  // 報名方式見 signupPayMode（EXTERNAL 導 1shop／PLATFORM 平台金流／MANUAL 手動收款）。
  // PLATFORM 走 SessionSignupOrder → PAYUNi 刷卡/ATM，付款成功自動轉入名單並開發票。
  signupSlug      String?   @unique // 報名頁網址代稱；null = 這場沒開報名頁
  isSignupOpen    Boolean   @default(false) // 報名頁總開關（關閉時頁面顯示「報名已結束」）
  dmImage         String? // DM 主視覺（瀏覽器直傳 Storage 的公開網址，同 Webinar.dmImage）
  // 課程詳情區塊：圖片與影片混排，順序即前台顯示順序（後台可拖曳調整）。
  // 形狀 [{ type: "image" | "video", url: string }]，解析走 parseDmBlocks（防禦式）。
  // 用 Json 而非另立一張表：這是一份「整包一起編輯」的有序清單，
  // 逐列 CRUD 反而更麻煩（同 introImages/dmImages 用陣列的既有慣例）。
  dmBlocks        Json      @default("[]")
  signupIntro     String?   @db.Text // 課程介紹（純文字換行，同 Webinar.description 慣例）
  venue           String? // 場地名稱（例：台北市青少年發展處 5F）
  address         String? // 地址（前台附 Google 地圖連結）
  signupOpenAt    DateTime? // 報名開始；null = 立即開放
  signupCloseAt   DateTime? // 報名截止；null = 不自動截止（仍受 isSignupOpen 與開課日限制）
  signupQuota     Int? // 名額上限（比對未延期的 SessionSignup 筆數）；null = 不限額
  // 外部報名網址（1shop）。有值 = 報名頁只當落地頁：顯示 CTA 導出去，
  // 不收表單、不管名額（席次由 1shop 控管，訂單照舊匯入場次看板）。
  // 留空 = 用平台自己的報名表單（走 SessionSignupRequest 待確認流程）。
  signupUrl       String?
  signupCtaLabel  String? // 導外部模式的 CTA 按鈕文字（例：前往查看課程介紹）；null = 預設「立即報名」
  signupPriceNote String? // 費用說明（Phase 1 純文字，例：早鳥 3800 / 原價 4500）
  signupPayNote   String?   @db.Text // 付款方式說明（匯款帳號、現場付款注意事項）
  signupNotice    String?   @db.Text // 注意事項／退費政策
  signupGroupId   String? // 報名成功自動加入的 MailGroup；null = 不加名單

  // ── 平台線上金流報名（Phase 2）──
  // 報名方式 2 選 1（signupPayMode）：EXTERNAL = 導外部連結（1shop，signupUrl）；
  // PLATFORM = 平台金流（signupPrice，刷卡/ATM，付款成功自動轉入名單＋開發票）；
  // MANUAL = 內建表單手動收款（既有 SessionSignupRequest 待確認流程）。
  // 舊資料 migration 依 signupUrl 有無回填 EXTERNAL / MANUAL，行為不變。
  signupPayMode          String   @default("MANUAL")
  signupPrice            Int? // PLATFORM 模式每人單價（NT$）＝新生／一般「特價」（實收）
  signupListPrice        Int? // 原價（純顯示：劃線對比特價，例 8880 劃線 → 5880）；null = 不顯示原價
  // 自動新舊生定價（PLATFORM 模式）：報名時用手機/email 查學員上課史，上過任一
  // signupRetrainCourseIds 的標準課程（CanonicalCourse.id）＝複訓 → 套 signupRetrainPrice；
  // 否則＝新生 → 套 signupPrice。signupRetrainPrice 為 null 或 courseIds 空 = 不分新舊生，一律 signupPrice。
  signupRetrainPrice     Int?
  signupRetrainCourseIds String[] @default([])

  signups        SessionSignup[]
  signupRequests SessionSignupRequest[]

  // 收支與分潤（見下方 SessionOrder 等模型的檔頭註解）
  finanOrders SessionOrder[]
  finanCosts  SessionCost[]
  finanShares SessionProfitShare[]
  finance     SessionFinance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 公開報名頁送出的「報名申請」（Phase 1：尚未接金流，收款靠匯款／現場付款）。
//
// 為什麼不直接寫 SessionSignup：那張表的既有語意是「已付款、確定要來的人」
//（1shop 只匯入金流狀態=已付款的列），下游的自動分組、葷素統計、簽到表、
// 課前通知全都建立在這個前提上。未收款的人直接進去會污染整條線。
// 管理員在後台確認收款後才「轉入名單」，複製成 SessionSignup 一列。
//
// 欄位刻意與 SessionSignup 對齊（一位參加者一列、共用 orderNo、attendeeKey），
// 轉正時是直接搬，不需要轉換邏輯。Phase 2 接上線上金流後，付款成功的
// webhook 走同一條轉正路徑，這張表就變成「待付款」的暫存區。
model SessionSignupRequest {
  id          String        @id @default(cuid())
  sessionId   String
  session     CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderNo     String // WEB-xxxx；同一次報名的多位參加者共用
  attendeeKey String // buyer / companion-1…（同 SessionSignup 慣例）

  name      String
  email     String?
  phone     String?
  meal      String  @default("MEAT") // MEAT 葷 / VEG 素
  isRetrain Boolean @default(false) // 報名時自稱複訓（舊生）；轉正時寫進 product

  // 訂購人資訊（每列都存一份：後台名單以參加者為單位，但要看得出誰付的錢）
  buyerName  String
  buyerEmail String?
  buyerPhone String?
  note       String? @db.Text // 訂購人備註，只記在 buyer 那列

  // PENDING 待確認收款 / CONFIRMED 已轉入名單 / CANCELLED 取消（未到款、重複報名）
  status      String    @default("PENDING")
  confirmedAt DateTime?
  signupId    String? // 轉正後對應的 SessionSignup.id（無 FK，名單列可被退款刪除）

  createdAt DateTime @default(now())

  @@unique([sessionId, orderNo, attendeeKey])
  @@index([sessionId, status])
}

// 場次報名（來源：1shop 訂單匯入／公開報名頁確認收款後轉入）。只收已付款的列。
model SessionSignup {
  id          String        @id @default(cuid())
  sessionId   String
  session     CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderNo     String // 1shop 訂單編號
  attendeeKey String        @default("buyer") // 同張訂單的報名者識別（buyer / companion-1…）
  name        String // 顧客姓名（看板顯示）
  email       String?
  phone       String?
  product     String? // 原始產品欄（追溯歸類依據）
  // @deprecated 不可加總：同訂單多人各記全額、多明細列只取第一列、延期複製。
  // 金額真值一律看 SessionOrderLine；此欄僅保留至寫入端清理（Phase 5）後移除。
  amount      Int?
  orderedAt   DateTime? // 訂單建立日期
  meal        String? // 葷素："MEAT" 葷 / "VEG" 素 / null 未標（統計時往安全側算葷）
  groupNo     Int? // 自動/手動分組結果；null = 未分組
  isStaff     Boolean       @default(false) // 工作人員：不列入分組與新舊生統計，但計入用餐葷素
  // 新舊生人工覆寫：null = 依 product 是否含「複訓」自動判斷（預設）；
  // true/false = 管理員在後台改過，一律以此為準（訂單買錯方案、代訂、事後才知道是舊生）。
  // 判別入口統一走 session-roster.isRetrainSignup，勿在別處自行讀這兩個欄位。
  isRetrain   Boolean?

  // 延期：原列保留但標記（排除於統計/分組/看板/簡訊），目標場次建新列。
  // 新列沿用原 orderNo+attendeeKey（跨場不撞唯一鍵）——1shop 退款的全域刪除
  // 會連延期列一併清掉（退款＝人不來了），重複匯入時原列擋住 skipDuplicates 不重建。
  // 無 FK（慣例同 PendingEnrollment.userId），場次名稱由頁面查詢解析。
  deferredToSessionId   String? // 有值 = 已延期至該場次
  deferredFromSessionId String? // 有值 = 由該場次延期而來（顯示「延期自…」）

  // 課前通知已送達的時間（null = 還沒通知到）。兩個通道各記一次：沒手機／海外門號
  // 的人只能走 Email，兩邊的完成度天生不同步。
  // 刻意記「已通知」而不是「匯入批次」——開課前會重複匯入名單，唯有這個口徑能讓
  // 「這場還有誰沒收到」永遠算得對（漏發、發失敗的人下次自動被撈回來）。
  // 只有**實際送出成功**才回寫；送失敗維持 null，下次仍列為未通知。
  smsNoticeAt   DateTime?
  emailNoticeAt DateTime?

  createdAt DateTime @default(now())

  @@unique([sessionId, orderNo, attendeeKey]) // 重複上傳冪等；一張訂單可有多位同行者
  @@index([sessionId])
}

// ── 場次收支與分潤 ──
// SessionSignup 是「誰要來上課」（一人一列，餵名單/分組/簽到表/簡訊/EDM），
// SessionOrder/SessionOrderLine 是「這筆錢從哪來」（一訂單一列＋逐明細列）。
// 兩者以 (sessionId, orderNo) 鬆耦合、不設 FK——手動加人、延期、退款刪名單列的
// 既有語意都不能被金額拖著走。
// 金額一律 Int = 新台幣元；費率一律存 ppm（百萬分之一：2% = 20000、2.4% = 24000），
// 理由同 SmsBroadcast 存「分」——2.4% 用整數百分比存不下。

// 場次收入的「訂單」層：一場次一訂單一列。
// 組合方案跨場認列 = 同 orderNo 在兩個場次各一筆 SessionOrder、各自認列一段。
model SessionOrder {
  id        String        @id @default(cuid())
  sessionId String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderNo   String // 1shop 訂單編號；現場/手動收入為 "ONSITE-xxxx"/"MANUAL-xxxx"
  source    String        @default("IMPORT") // IMPORT 1shop匯入 / MANUAL 後台手建 / ONSITE 現場收款

  buyerName  String
  buyerPhone String?
  buyerEmail String?
  payerName  String? // 「不同付款人」（夫妻代付）；null = 同 buyerName

  // 付款方式：正規化碼＋原始字串。1shop 的「金流」寫法不只一種
  //（信用卡/信用卡線上付款/信用卡分3期/單筆滿3000可信用卡分3期…），
  // 正規化規則會演進，留原文才能重新對照而不必重匯。
  paymentMethod    String  @default("UNKNOWN") // CREDIT_ONE / CREDIT_INSTALLMENT / ATM / CASH / OTHER / UNKNOWN
  paymentMethodRaw String?
  installments     Int     @default(0) // 分期數；0 = 非分期

  orderStatus   String? // 1shop 原始訂單狀態（追溯用）
  paymentStatus String? // 1shop 原始金流狀態
  orderedAt     DateTime?
  seats         Int       @default(1) // 訂單席次加總（與名單人數對帳用）

  // 外部分潤歸屬（1shop 原文，追溯用）：
  // 銷售頁名稱含「(推廣者-XXX專用)」＝頁主；推薦人欄有名字＝推薦人（優先）。
  // 自動分潤建議由 compute 層即時算，不落地——原文在就能隨規則演進重算
  salesPage     String? // 1shop「銷售頁名稱」
  salesPageCode String? // 1shop「銷售頁編號前綴」（02A / 08K…）
  referrer      String? // 1shop「推薦人」

  // 結算控制
  isRecognized   Boolean   @default(true) // false = 暫不認列（分期未繳完等），收入不計
  excludeReason  String? // 不認列原因（匯出時進底部逐條例外說明）
  refundedAt     DateTime? // 有值 = 已退款。名單列會被匯入端刪除，金額列保留供追溯
  refundAmount   Int       @default(0)
  // 任何後台人工編輯（金額/認列/方案名）一律設 true：
  // 之後重匯只更新原始追溯欄位，金額與認列一概不動——否則使用者
  // 花半小時處理完組合方案認列，隔天重匯就全部消失且沒有錯誤訊息。
  manualOverride Boolean   @default(false)
  note           String?   @db.Text

  lines SessionOrderLine[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, orderNo]) // 重匯冪等
  @@index([sessionId])
  @@index([orderNo])
}

// 收入明細的最小單位：一列 = 1shop 的一條明細（或一筆手動收入）。
// 收支表的「收入明細」= GROUP BY (planLabel, 訂單.paymentMethod, unitPrice)。
// 「複訓×2＋新生×1」一張訂單會落在兩個不同收入列——這正是只存訂單層會漏錢的原因。
model SessionOrderLine {
  id      String       @id @default(cuid())
  orderId String
  order   SessionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productRaw String // 1shop「產品」欄原文（歸類與追溯依據，永不改）
  planLabel  String // 收入明細「項目」的方案名（例：進階正價／複訓生方案），可改
  unitPrice  Int // 每人單價（元）
  quantity   Int    @default(1)
  amount     Int // 小計（元）= 1shop 原值 =「付款金額」

  // 認列金額 ≠ 付款金額的唯一出口，預設 = amount。
  // 組合方案訂單在本場只認列本場那一段（例：訂單 8,680 只認列進階部分），
  // 由後台人工指定，不自動拆。
  recognizedAmount Int
  recognizeNote    String? // 例：「本表僅計入 AI 進階 8/1 的 8,680」

  // 收入明細的分類鍵之一：NEW 新生 / RETRAIN 複訓。
  // null = 依 productRaw 是否含「複訓」自動判斷（同 session-roster.isRetrainProduct）；
  // 有值 = 後台人工改過（訂單買錯方案、代訂），一律以此為準——與 SessionSignup.isRetrain 同一套覆寫哲學
  studentType String?
  isOnsite    Boolean @default(false) // 現場收款（與線上合在同一張收入明細，僅標示來源）
  sortOrder   Int     @default(0)

  @@index([orderId])
}

// 支出明細：費率型（自動）／固定型（手填）／外部分潤（毛收×%）三類合一張表——
// Excel 的「二、支出明細」本來就是一個連續區塊一起加總成總支出，
// 外部分潤（講師抽成）也在這一區先扣，扣完的毛利才進內部分潤。
model SessionCost {
  id        String        @id @default(cuid())
  sessionId String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  kind  String // RATE 費率自動 / FIXED 固定手填 / EXTERNAL_SHARE 外部分潤
  // RATE 專用科目碼：INVOICE_TAX 發票稅金 / INCOME_TAX 營所稅 / CARD_FEE 刷卡單筆
  // / CARD_INSTALLMENT_FEE 刷卡分期 / ATM_FEE / REMIT_FEE 分潤匯費
  code  String?
  label String // 顯示名：「發票稅金」「便當」「講師抽成-黃OO」

  basisText   String? // 「計算基礎」欄顯示文字：「信用卡單筆 NT$34,720 × 2%」
  basisAmount Int? // 計算基礎金額（元）
  ratePpm     Int? // 費率 ppm（2% = 20000）
  unitAmount  Int? // 單筆固定費（ATM $15/筆）
  unitCount   Int? // 筆數
  amount      Int // 本列金額（元，已四捨五入）

  // true = 系統自動產生，重算時刪除重建；false = 人工填入或覆寫，重算一律不動
  //（分享會舊版 ATM 用金額×1% 而非 $15/筆，就是靠人工列保住）
  isAuto Boolean @default(true)
  payee  String? // EXTERNAL_SHARE 的分潤對象（講師/推廣者姓名）
  note   String?

  sortOrder Int @default(0)

  @@index([sessionId])
}

// 內部分潤：外部分潤已在支出扣除後，對毛利按比例分配
model SessionProfitShare {
  id        String        @id @default(cuid())
  sessionId String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payeeName String // 顧院長 / 孟宏 / 舒庭…
  sharePpm  Int // 比例 ppm：40% = 400000
  amount    Int // ROUND(毛利 × 比例)，重算時更新
  note      String?
  sortOrder Int           @default(0)

  @@unique([sessionId, payeeName])
  @@index([sessionId])
}

// 場次結算表頭（1:1）。LOCKED 後快照凍結、重匯與費率調整都不再改動——
// 沒有快照，日後調一次費率會讓所有歷史場次數字集體漂移，跟已發出的分潤對不上。
model SessionFinance {
  sessionId String        @id
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status    String        @default("DRAFT") // DRAFT / LOCKED

  totalIncome Int @default(0) // 結算快照
  totalCost   Int @default(0)
  grossProfit Int @default(0)

  sourceFile String? // 「order_2026_08_01_10_23_45.xlsx」（收支表底部的資料來源列）
  sourceNote String? @db.Text // 底部逐條例外說明（自動草稿＋人工補）

  lockedAt DateTime?
  lockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 產品原文 → 收支表方案顯示名（全域對照，一次設定長期受用）。
// 1shop 產品欄是「AI進階班 8/1 台北場｜進階正價方案」這種長字串，
// 同一批字串每個月都會再出現；完整原文比對、不做模糊比對（避免誤套）。
model FinancePlanAlias {
  productRaw String   @id
  planLabel  String
  updatedBy  String?
  updatedAt  DateTime @updatedAt
}

// 待開通名單：批次開通遇「查無會員」時存底（以 email 為鍵），
// 學員之後註冊（或管理員建帳號）當下自動認領 → 寫入 Enrollment。
// claimedAt 有值 = 已認領（留存稽核，不重複觸發）；待註冊人數 = claimedAt IS NULL。
model PendingEnrollment {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  email    String // 一律小寫正規化（normalizeEmail）
  name     String? // 名單附的姓名（認領建帳號時備查）

  createdBy String? // 存底的管理員 email（備查）
  createdAt DateTime  @default(now())
  claimedAt DateTime? // 認領時間（註冊/建帳號當下）
  userId    String?   @db.Uuid // 認領人 auth.users.id（無 FK，慣例同 Enrollment）

  @@unique([courseId, email]) // 同課程同 email 只存一筆，重貼名單冪等
  @@index([email])
}

model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  youtubeId   String // 只存 YouTube video id，播放頁才組成 embed
  slideUrl    String? // 線上簡報嵌入網址（Google Slides/Canva），播放頁影片下方顯示
  order       Int
  durationSec Int?

  @@index([courseId])
}

// 課程講義（下載檔案，存 Supabase Storage 或外部網址）
model CourseMaterial {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  url      String

  createdAt DateTime @default(now())

  @@index([courseId])
}

model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique // ECPay MerchantTradeNo（≤20 字元，加密安全亂數）
  // 結帳防重原子鍵：PENDING 時 = "userId:courseId"，離開 PENDING 一律清 null。
  // nullable unique（PG 允許多個 NULL）保證同 user 同課程同時只有一筆有效 PENDING，
  // 併發下單靠 unique violation 擋，不靠先查再建
  checkoutKey String?     @unique
  // auth.users.id，無 FK。**可為 null = 訪客下單**（未註冊就能買）：
  // 付款成功時才用 buyerEmail 建立／連結帳號並回填，然後開通課程。
  // 未付款的訪客訂單永遠不會產生帳號（避免有人拿公開結帳端點灌帳號）。
  userId      String?     @db.Uuid
  // 訂購人快照（下單當下抓，對齊 1shop 訂單介面）：會員之後改資料不影響歷史訂單。
  // name 取自 QBC profiles.display_name、phone 取自 MemberProfile（都可能缺）
  buyerEmail  String?
  buyerName   String?
  buyerPhone  String?
  status      OrderStatus @default(PENDING)
  subtotal    Int // 折扣前總額
  discount    Int         @default(0) // 套用的折扣金額
  total       Int // 實付 = subtotal - discount
  tierAtOrder Int? // 下單當下等級 level（稽核用）

  items   OrderItem[]
  payment Payment?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course @relation(fields: [courseId], references: [id])
  unitPrice Int // 下單當下價格快照

  @@unique([orderId, courseId])
  @@index([courseId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String // "ecpay" | "newebpay"
  status      PaymentStatus @default(PENDING)
  amount      Int
  tradeNo     String? // 金流商交易序號（回傳）
  paymentType String? // Credit / ATM / CVS…
  rawCallback Json? // 完整 callback 存證
  notifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 場次線上金流訂單（平台金流報名，CourseSession.signupPayMode = PLATFORM）。
// 與課程 Order 分開：報名是「訪客免登入」且要的是「進場次名單（SessionSignup）」而非
// 「開通觀看（Enrollment）」，硬塞進 Order（userId 必填、courseId 導向）會攪亂兩套語意。
// 付款成功由 /api/payment/<provider>/session-notify 結算：逐位建 SessionSignup、開 ezPay
// 發票、加名單群組。ATM 取號走 PAYUNi 三態，繳款完成才轉入名單。
// 軟連結（sessionId 純量、不設 FK，比照 InvoiceRecord.orderId）。
// 命名避開財務模組既有的 SessionOrder（那是 1shop 收入認列/分潤，與結帳無關）。
model SessionSignupOrder {
  id          String      @id @default(cuid())
  orderNo     String      @unique // 場次訂單編號（與課程 orderNo 前綴區隔）
  sessionId   String
  // 訂購人聯絡資訊快照（訪客免登入）
  buyerEmail  String
  buyerName   String
  buyerPhone  String
  // 參加者名單快照（含同行者）[{name,phone,email,meal,isRetrain}]；付款成功後逐位建 SessionSignup
  attendees   Json
  quantity    Int // 報名人數
  unitPrice   Int // 每人單價快照
  total       Int // = unitPrice × quantity
  status      OrderStatus @default(PENDING)
  // 防重下單：同場次同 email 只允許一筆有效 PENDING（PENDING=`sessionId:buyerEmail`，離開 PENDING 清 null）
  checkoutKey String?     @unique
  provider    String
  tradeNo     String? // 金流商交易序號
  paymentType String? // Credit / ATM…
  rawCallback Json? // 完整 callback 存證
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sessionId, status])
}

// 電子發票開立紀錄（ezPay 加值中心）。
// 開票掛在金流 notify 的付款成功之後、DB transaction 之外——外部 API 不能拖住
// 開通課程的 transaction；開票失敗只記錄在這，不影響訂單狀態，後台可重試。
// 一張訂單最多一張發票（orderId unique），重試走 update 不會重複開立。
model InvoiceRecord {
  id      String @id @default(cuid())
  orderId String @unique
  orderNo String // 冗餘存一份，後台列表不用 join

  // PENDING 待開立（送出前）/ ISSUED 已開立 / FAILED 失敗（error 有原因，可重試）
  status         String    @default("PENDING")
  invoiceNumber  String? // 發票號碼（如 UY25000014）
  randomNum      String? // 4 碼防偽隨機碼（買受人對獎用）
  invoiceTransNo String? // ezPay 開立序號
  buyerEmail     String? // 開立當下的買受人信箱（ezPay 會員載具識別）
  totalAmt       Int // 發票金額（含稅）
  issuedAt       DateTime?
  error          String?   @db.Text // 最後一次失敗原因
  attempts       Int       @default(0)
  raw            Json? // ezPay 回應存證

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// 已購買關係 — 「能不能看課程」的唯一真實來源
model Enrollment {
  id       String  @id @default(cuid())
  userId   String  @db.Uuid // auth.users.id，無 FK
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])
  orderId  String? // 來源訂單
  source   String? // 開通來源：PURCHASE/MANUAL/BATCH/IMPORT（null=歷史資料，顯示時依 orderId 推斷）

  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // 防重複授權，並保證 webhook 冪等
  @@index([userId])
}

// ── 簡訊模組 ────────────────────────────────────────────────
// 對照 EmailBroadcast 的設計：發送對象只存描述，名單於「發送當下」才解析
// （場次取最新報名），關聯一律軟連結不加 FK，場次被刪除時歷史紀錄仍完整保留。
// status：DRAFT / SCHEDULED（排程待發）/ SENDING（cron 處理中）/ SENT / CANCELED / FAILED
// audienceType：SESSION（場次報名者，可複選）/ GROUP（名單群組，第二階段）/ MANUAL（手動貼名單）
// 沒有 ALL：會員資料表沒有手機，且「簡訊轟炸全體會員」本來就不該存在
model SmsBroadcast {
  id          String  @id @default(cuid())
  title       String? // 後台識別用，不會出現在簡訊內容裡
  body        String  @db.Text
  messageType String  @default("NOTICE") // NOTICE（履約通知）/ MARKETING（行銷推播，需帶退訂連結）

  audienceType  String   @default("MANUAL")
  sessionIds    String[] @default([]) // audienceType=SESSION 的場次（可複選，發送當下取最新報名）
  groupIds      String[] @default([]) // audienceType=GROUP（第二階段：名單群組加手機後才接線）
  audienceLabel String? // 顯示用：場次：xxx / 場次 N 場（已去重）：… / 手動名單 N 筆
  manualRows    Json? // audienceType=MANUAL 時的名單 [{mobile,name}]
  // audienceType=SESSION 的名單範圍：ALL＝全部報名者；PENDING＝只發 smsNoticeAt 為空的人
  // （開課前重複匯入後，只通知這次新進來的）。同樣在**發送當下**解析。
  noticeScope   String   @default("ALL")
  // 回寫 smsNoticeAt 用的名單列 id。SESSION 由解析結果自動帶入；
  // MANUAL 的單人補通知由頁面帶入（否則補發過的人會一直留在「未通知」被重複發送）。
  signupIds     String[] @default([])

  sentCount     Int @default(0)
  failedCount   Int @default(0)
  excludedCount Int @default(0) // 因退訂/無法送達被排除的人數
  noMobileCount Int @default(0) // 名單中沒有可用手機的人數（發送前就要讓操作者看到）

  // 成本快照（存「分」不存「元」：簡訊單價低於 NT$1，存整數元會全部變成 0 或 1）
  segments           Int @default(0) // 單則預估則數
  actualSegments     Int @default(0) // 實際送出則數總和（{name} 長度不一，逐人計算後加總）
  unitPriceCents     Int @default(0) // 發送當下的單價快照
  estimatedCostCents Int @default(0)

  provider String? // dryrun（測試模式，未實際發送）/ 日後的簡訊商代號；列表必須明確標示
  status   String  @default("SENT")

  scheduledAt DateTime? // 預定發送時間（null = 立即發送）
  sentAt      DateTime? // 實際發送時間
  claimedAt   DateTime? // 進入 SENDING（cron 認領）的時間；用於回收逾時卡死的發送

  recipients       String[] @default([]) // 實際送出名單快照（已正規化的 09XXXXXXXX）
  failedRecipients Json? // 逐筆失敗名單 [{mobile,name?,reason}]；全成功設 null
  resendOfId       String? // 補發失敗者時記來源紀錄 id（軟連結，與 EmailBroadcast 慣例一致）

  sentBy      String? // 操作的管理員 email
  noticeAckBy String? // 勾選「這是履約通知，非行銷推播」的管理員 email

  deliveredCount Int @default(0) // 電信回報已送達的人數（列表用；明細以 SmsMessage 為準）

  messages SmsMessage[]

  createdAt DateTime @default(now())

  @@index([status, scheduledAt]) // cron 撈到期排程
  @@index([sentAt]) // 每日則數上限的加總查詢
}

// 簡訊退訂／無法送達名單。source：
//   USER     使用者自行退訂（僅過濾行銷簡訊）
//   MANUAL   客服代為退訂（僅過濾行銷簡訊）
//   INVALID  空號/停用/業者回報無法送達（行銷與履約通知一律過濾）
//   PROVIDER 業者主動回報
// 與 MailUnsubscribe 的差異：行銷退訂不得擋掉已報名學員的上課提醒（那是履約通知）
/// 逐筆簡訊發送紀錄：一個收件人一列，追蹤到電信端的最終狀態。
/// 沒有這張表就查不到送達情形——簡訊商的 message_id 以前送出後就丟掉了。
model SmsMessage {
  id          String       @id @default(cuid())
  broadcastId String
  broadcast   SmsBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  mobile String // normalizeMobile 後的 09XXXXXXXX
  name   String? // 發送當下的姓名快照（名單之後改名也查得回原樣）

  /// 簡訊商的 message id（MAAC Go 為 sms_xxx）；連 API 都沒送出去時為 null
  providerMessageId String? @unique
  /// QUEUED 待送 / SENT 電信已接收 / DELIVERED 已送達 / FAILED 失敗 / STOP 拒收退訂
  status            String  @default("QUEUED")
  segments          Int     @default(0)
  costCents         Int     @default(0)
  error             String? // 失敗原因（簡訊商回的英文碼會轉成中文顯示）

  sentAt      DateTime?
  deliveredAt DateTime?
  checkedAt   DateTime? // 最後一次向簡訊商查詢狀態的時間

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([broadcastId])
  @@index([status]) // 定期只查還沒有最終狀態的（QUEUED/SENT）
}

model SmsOptOut {
  mobile    String   @id // 一律存 normalizeMobile 後的 09XXXXXXXX
  reason    String?
  source    String   @default("USER")
  createdAt DateTime @default(now())
}
